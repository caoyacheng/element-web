Tiang enterprise theme: cool light-blue surfaces, tender green accents, orange for attention states.
Overrides Compound tokens in the compound.custom layer (see Element theming docs).
*/

@layer compound.custom {
    :root,
    [class*="cpd-theme-"] {
        /* Primary “淡蓝” surfaces */
        --cpd-color-theme-bg: #f0f7fc;
        --cpd-color-bg-subtle-primary: #e2edf7;
        --cpd-color-bg-subtle-secondary: #d8e6f4;

        /* “嫩绿” emphasis — links, accents, primary actions */
        --cpd-color-text-action-accent: #15803d;
        --cpd-color-text-link-external: #166534;
        --cpd-color-icon-accent-tertiary: #16a34a;
        --cpd-color-icon-accent-primary: #15803d;
        --cpd-color-bg-accent-rest: #15803d;
        --cpd-color-bg-accent-hovered: #166534;
        --cpd-color-bg-accent-pressed: #14532d;
        --cpd-color-border-accent-subtle: #22c55e;
        --cpd-color-bg-accent-selected: rgb(34 197 94 / 18%);
        --cpd-color-gradient-action-stop1: #4ade80;
        --cpd-color-gradient-action-stop2: #22c55e;
        --cpd-color-gradient-action-stop3: #15803d;
        --cpd-color-gradient-action-stop4: #14532d;

        /* “橙色” attention / critical affordances */
        --cpd-color-text-critical-primary: #c2410c;
        --cpd-color-icon-critical-primary: #ea580c;
        --cpd-color-bg-critical-primary: #c2410c;
        --cpd-color-bg-critical-hovered: #9a3412;
        --cpd-color-bg-critical-subtle: #ffedd5;
        --cpd-color-border-critical-primary: #ea580c;

        /* Enterprise-neutral type */
        --cpd-color-text-primary: #1e293b;
        --cpd-color-text-secondary: #475569;

        /* Structure & focus */
        --cpd-color-border-focused: #2563eb;
        --cpd-color-border-interactive-primary: #94a3b8;
        --cpd-color-bg-action-primary-rest: #15803d;
        --cpd-color-bg-action-primary-hovered: #166534;
        --cpd-color-bg-action-primary-pressed: #14532d;
    }
}
