.mx_Login_submit {
    width: 100%;
    margin-top: 24px;
    margin-bottom: 24px;
}

.mx_Login_loader {
    display: inline;
    position: relative;
    top: 2px;
    left: 8px;
}

.mx_Login_loader .mx_Spinner {
    display: inline;
}

.mx_Login_loader .mx_Spinner img {
    width: 16px;
    height: 16px;
}

.mx_Login_error {
    color: $alert;
    font-weight: bold;
    text-align: center;
    margin-top: 12px;
    margin-bottom: 12px;
}

.mx_Login_error.mx_Login_serverError {
    text-align: left;
    font-weight: normal;
}

.mx_Login_error.mx_Login_serverError.mx_Login_serverErrorNonFatal {
    color: #ff8d13; /* Only used here */
}

.mx_Login_type_container {
    display: flex;
    align-items: center;
    color: $authpage-primary-color;

    .mx_Field {
        margin: 0;
    }
}

.mx_Login_type_label {
    flex: 1;
}

.mx_Login_underlinedServerName {
    width: max-content;
    border-bottom: 1px dashed $accent;
}

div.mx_AccessibleButton_kind_link.mx_Login_forgot {
    display: block;
    margin-top: 24px;

    &.mx_AccessibleButton_disabled {
        cursor: not-allowed;
    }
}

.mx_Login_spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    align-content: center;
    padding: 14px;
}

.mx_Login_fullWidthButton {
    width: 100%;
    margin-bottom: 16px;
}

.mx_LoginPage {
    width: 100%;
    max-width: 1120px;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 64px;
    padding: 16px 24px;
    box-sizing: border-box;
}

.mx_LoginPage_intro {
    flex: 1;
    max-width: 620px;
    color: $authpage-primary-color;
}

.mx_LoginPage_intro h1 {
    margin: 0 0 24px;
    font-size: 52px;
    line-height: 1.15;
    font-weight: var(--cpd-font-weight-semibold);
    letter-spacing: 0.5px;
}

.mx_LoginPage_intro p {
    margin: 0;
    max-width: 560px;
    font-size: $font-16px;
    line-height: 1.9;
    color: $authpage-secondary-color;
}

.mx_LoginPage_introLanguage {
    margin-top: 40px;
    max-width: 180px;
}

.mx_LoginPage_authBody {
    width: 380px;
    min-height: 500px;
    border-radius: 14px;
    box-shadow: 0 16px 44px rgba(27, 43, 65, 20%);
    padding: 34px 34px 30px;
}

.mx_LoginPage_authBody h1 {
    margin-top: 0;
    margin-bottom: 22px;
    font-size: 32px;
}

.mx_LoginPage_authBody .mx_ServerPicker {
    margin-bottom: 18px;
}

.mx_LoginPage_authBody .mx_Login_submit,
.mx_LoginPage_authBody .mx_Login_fullWidthButton {
    height: 44px;
    margin-top: 18px;
    margin-bottom: 18px;
    border-radius: 8px;
}

.mx_LoginPage_authBody button.mx_Login_submit,
.mx_LoginPage_authBody button.mx_Login_fullWidthButton {
    color: #fff;
    background: linear-gradient(90deg, #2264ff 0%, #36b8f4 100%);
    border: 0;
}

@media only screen and (max-width: 960px) {
    .mx_LoginPage {
        gap: 24px;
        padding: 16px;
    }

    .mx_LoginPage_intro h1 {
        font-size: 40px;
    }
}

@media only screen and (max-width: 760px) {
    .mx_LoginPage {
        min-height: unset;
        flex-direction: column;
        align-items: stretch;
    }

    .mx_LoginPage_intro {
        max-width: none;
        text-align: center;
    }

    .mx_LoginPage_introLanguage {
        margin: 20px auto 0;
    }

    .mx_LoginPage_authBody {
        width: 100%;
        min-height: unset;
    }
}
